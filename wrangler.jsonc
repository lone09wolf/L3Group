{
  "name": "l3group",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "L3_TO_EMAIL": "inquiries@l3group.co.za"
  },
  "ratelimits": [
    {
      "name": "ENQUIRY_RATE_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
